# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=camstack

# Model
MODEL_PATH=models/best.pt
STUDENT_MAP_PATH=models/student_id_map.json
CONFIDENCE_THRESHOLD=0.7
CONFIRMATION_FRAMES=3

# Realtime quality gate (dlib)
LANDMARK_MODEL_PATH=models/shape_predictor_68_face_landmarks.dat
REALTIME_QUALITY_ENABLE=true
REALTIME_ALIGNMENT_ENABLE=true
REALTIME_MIN_BRIGHTNESS=60
REALTIME_MAX_BRIGHTNESS=200
REALTIME_MIN_SHARPNESS=80
REALTIME_MAX_ROLL_DEG=20
REALTIME_MIN_FACE_SIZE=80

# Realtime tracking/voting
REALTIME_TRACKING_ENABLE=true
REALTIME_TRACK_IOU=0.3
REALTIME_TRACK_MAX_AGE=10
REALTIME_TRACK_MIN_HITS=3

# Upload video tracking/voting
VIDEO_TRACKING_ENABLE=true
VIDEO_TRACK_IOU=0.3
VIDEO_TRACK_MAX_AGE=10
VIDEO_TRACK_MIN_HITS=3

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
